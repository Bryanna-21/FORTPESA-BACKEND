# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://fortpesa:fortpesa@localhost:5432/fortpesa_platform?schema=public

# ---------------------------------------------------------------------------
# Redis (rate limiting, queue, reconciliation locks)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Fortpesa provider credentials
# Obtain from the Fortpesa merchant dashboard: Settings -> Developer APIs.
# ---------------------------------------------------------------------------
FORTPESA_BASE_URL=https://fortpesa.co.ke
FORTPESA_API_KEY=pb_live_replace_me
FORTPESA_WEBHOOK_SECRET=replace_me
FORTPESA_TIMEOUT_MS=15000

# The exact header Fortpesa uses to carry the webhook HMAC signature and the
# exact status-lookup / wallet-balance paths are not published on the public
# marketing site at the time this platform was built. These are isolated as
# configuration rather than hardcoded — see docs/fortpesa.md "Confirmed vs
# assumed behavior" before going live and correct them from the merchant
# dashboard's API reference once available.
FORTPESA_WEBHOOK_SIGNATURE_HEADER=X-Fortpesa-Signature
FORTPESA_STK_PATH=/api/v1/payments/stk
FORTPESA_STATUS_PATH_TEMPLATE=/api/v1/payments/{uuid}
FORTPESA_WALLET_BALANCE_PATH=/api/v1/wallet/balance

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
API_KEY_PEPPER=replace_with_random_64_byte_hex
ADMIN_API_KEY_PREFIX=fpa_admin_
MERCHANT_API_KEY_PREFIX=fpa_live_
SESSION_SECRET=replace_with_another_random_64_byte_hex
SESSION_TTL_MINUTES=720

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
PAYMENT_EXPIRY_MINUTES=15
MAX_PAYMENT_RETRY_ATTEMPTS=3
MIN_PAYMENT_AMOUNT_MINOR_UNITS=100
MAX_PAYMENT_AMOUNT_MINOR_UNITS=15000000
